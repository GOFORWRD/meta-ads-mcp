# Copy this file to .env and fill in the values you need, then it will be
# loaded automatically (no need to `export` anything in your shell).
#
# Pick ONE authentication method below.

# --- Option 1: Pipeboard auth (recommended, no Meta Developer App needed) ---
# Get a token at https://pipeboard.co
# PIPEBOARD_API_TOKEN=

# --- Option 2: Direct Meta auth (self-created Meta Developer App) ---
# From developers.facebook.com/apps/<app-id>/settings/basic/
# App Domains must include "localhost", and Facebook Login > Settings >
# Valid OAuth Redirect URIs must include http://localhost:8080/callback
# META_APP_ID=
# META_APP_SECRET=

# If Meta's "App Domains" field rejects the literal string "localhost",
# map a fake hostname to loopback instead: add "127.0.0.1 metaadslocal.dev"
# to /etc/hosts, put "metaadslocal.dev" in App Domains and in the Valid
# OAuth Redirect URI (http://metaadslocal.dev:8080/callback), then set:
# META_ADS_OAUTH_HOST=metaadslocal.dev

# If Meta also enforces HTTPS on redirect URIs (Client OAuth settings >
# "Enforce HTTPS" locked to Yes), serve the callback over TLS with a
# locally-trusted cert:
#   brew install mkcert nss && mkcert -install && mkcert metaadslocal.dev
# then update the Valid OAuth Redirect URI to
# https://metaadslocal.dev:8080/callback and set:
# META_ADS_OAUTH_CERT_FILE=./metaadslocal.dev.pem
# META_ADS_OAUTH_KEY_FILE=./metaadslocal.dev-key.pem

# --- Optional feature flags ---
# META_ADS_ENABLE_SAVE_AD_IMAGE_LOCALLY=
# META_ADS_DISABLE_ADS_LIBRARY=
# META_ADS_ENABLE_DUPLICATION=
# META_ADS_ENABLE_REPORTS=
# META_ADS_DISABLE_LOGIN_LINK=
# META_ADS_DISABLE_CALLBACK_SERVER=
